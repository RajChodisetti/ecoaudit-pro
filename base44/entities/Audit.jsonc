{
  "name": "Audit",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "maxLength": 300,
      "title": "Client Name",
      "description": "Client display name. The unified API normalizes this value for matching."
    },
    "unified_client_id": {
      "type": "string",
      "maxLength": 200,
      "title": "Unified Client ID",
      "description": "Server-issued client-directory link; never entered by the user."
    },
    "unified_site_id": {
      "type": "string",
      "maxLength": 200,
      "title": "Unified Site ID",
      "description": "Server-issued saved-site link; never entered by the user."
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "site_address": {
      "type": "string",
      "maxLength": 1000,
      "title": "Site Address",
      "description": "Display address exactly as selected or manually entered."
    },
    "site_locality": {
      "type": "string",
      "maxLength": 200,
      "title": "Suburb or Locality"
    },
    "site_state": {
      "type": "string",
      "enum": [
        "ACT",
        "NSW",
        "NT",
        "QLD",
        "SA",
        "TAS",
        "VIC",
        "WA"
      ],
      "title": "State or Territory"
    },
    "site_postcode": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "title": "Postcode"
    },
    "site_country_code": {
      "type": "string",
      "enum": [
        "AU"
      ],
      "default": "AU",
      "title": "Country Code"
    },
    "site_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "title": "Latitude"
    },
    "site_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "title": "Longitude"
    },
    "site_geocode_provider": {
      "type": "string",
      "enum": [
        "geoapify",
        "photon"
      ],
      "title": "Geocoding Provider"
    },
    "site_geocode_place_id": {
      "type": "string",
      "maxLength": 500,
      "title": "Provider Place ID"
    },
    "site_address_source": {
      "type": "string",
      "enum": [
        "suggested",
        "manual",
        "client_saved"
      ],
      "default": "manual",
      "title": "Address Source"
    },
    "site_geocode_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved",
        "manual",
        "failed"
      ],
      "default": "unresolved",
      "title": "Geocoding Status"
    },
    "site_address_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "title": "Address Fingerprint"
    },
    "site_geocoded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Geocoded At"
    },
    "inspector_name": {
      "type": "string",
      "title": "Inspector Name"
    },
    "audit_date": {
      "type": "string",
      "format": "date",
      "title": "Audit Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Completed"
      ],
      "default": "Draft",
      "title": "Status"
    }
  },
  "required": [
    "site_name",
    "site_address",
    "inspector_name",
    "audit_date"
  ]
}
